# Production environment example

# Environment
ENVIRONMENT=production
SECRET_KEY=change-me
SETUP_TOKEN=change-me
AGENT_TOKEN=change-me
AUTO_SCHEMA=false

# Database (Supabase/PostgreSQL)
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres

# CORS - Allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:8000

# Public tokens (optional in development)
PUBLIC_API_TOKEN=change-me
PUBLIC_WS_TOKEN=change-me

# Email Configuration (for booking confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=VRacing Bar
SMTP_FROM_EMAIL=your-email@gmail.com

# Payments
PAYMENT_CURRENCY=EUR
PUBLIC_KIOSK_URL=http://localhost:8000/kiosk
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:8000/kiosk?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/kiosk?payment=cancel
BIZUM_RECEIVER=600000000

# Optional integrations
ENABLE_VMS_INTEGRATION=false

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# License verification
LICENSE_PUBLIC_KEY_PATH=C:\path\to\public_key.pem
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
