# Database (Supabase/PostgreSQL)
DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres

# Environment
ENVIRONMENT=production
REQUIRE_SECRETS=true
SECRET_KEY=change-me
SETUP_TOKEN=change-me
AGENT_TOKEN=change-me
AUTO_SCHEMA=false
UPDATE_SIGNING_KEY=change-me

# CORS - Allowed origins for the frontend
ALLOWED_ORIGINS=http://localhost:3010

# Public tokens (optional in development)
PUBLIC_API_TOKEN=change-me
PUBLIC_WS_TOKEN=change-me
ALLOW_PUBLIC_TOKEN_QUERY=false
# WebSocket clients should authenticate with an initial identify frame.
# Keep query tokens disabled unless you need temporary legacy compatibility.
ALLOW_WS_TOKEN_QUERY=false
# Emergency override (production only): allow query-string tokens when explicitly accepted.
ALLOW_INSECURE_QUERY_TOKENS=false

# Scoped API keys (recommended). If set, these replace PUBLIC_API_TOKEN/PUBLIC_WS_TOKEN behavior.
# Format: token:scope1,scope2;token2:scopeA,scopeB
# CLIENT_TOKENS=public-token:public:read,ws:public;  kiosk-token:bookings:read,bookings:write,kiosk:control,payments:write,public:read,ws:public
# CLIENT_TOKENS_JSON={"public-token":["public:read","ws:public"],"kiosk-token":["bookings:read","bookings:write","kiosk:control","payments:write","public:read","ws:public"]}

# Agent tokens with scopes (recommended). If set, these replace AGENT_TOKEN behavior.
# AGENT_TOKENS=agent-token:agent:ws,agent:report,agent:update,agent:register,agent:manifest,agent:session,agent:logs
# AGENT_TOKENS_JSON={"agent-token":["agent:ws","agent:report","agent:update","agent:register","agent:manifest","agent:session","agent:logs"]}

# WebSocket multi-worker (requires Redis pubsub)
# ALLOW_MULTI_WORKER_WS=true
# WS_PUBSUB=redis
# REDIS_URL=redis://localhost:6379/0

# Optional integrations
ENABLE_VMS_INTEGRATION=false

# Streaming fallback (used when a station has no explicit stream_url in DB)
# For LAN low latency, prefer WebRTC:
# STREAM_BASE_URL=http://192.168.1.10:8889/live
# STREAM_FALLBACK_MODE=webrtc  # webrtc|flv|hls

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:admin@example.com

# License verification
LICENSE_PUBLIC_KEY_PATH=C:\path\to\public_key.pem
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...

# License enforcement in development (production enforces by default)
# ENFORCE_LICENSE=false

# Email Configuration (for booking confirmations)
# For Gmail: Use App Passwords (not your regular password)
# Go to: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=VRacing Bar
SMTP_FROM_EMAIL=your-email@gmail.com

# Payments
PAYMENT_CURRENCY=EUR
PUBLIC_KIOSK_URL=http://localhost:3010/kiosk
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:3010/kiosk?payment=success
STRIPE_CANCEL_URL=http://localhost:3010/kiosk?payment=cancel
BIZUM_RECEIVER=600000000

# Observability / operational alerts
# Rolling metrics window for /system/metrics and /system/alerts
OBSERVABILITY_WINDOW_SECONDS=300
OBSERVABILITY_MAX_RECENT_EVENTS=50000
# Alert thresholds (applied when recent requests >= ALERT_MIN_REQUESTS)
ALERT_MIN_REQUESTS=50
ALERT_ERROR_RATE_WARN=0.10
ALERT_ERROR_RATE_CRIT=0.20
ALERT_SERVER_ERROR_RATE_WARN=0.02
ALERT_SERVER_ERROR_RATE_CRIT=0.05
ALERT_P95_WARN_MS=800
ALERT_P95_CRIT_MS=2000
# Station availability alerts
ALERT_STATIONS_MIN_TOTAL=3
ALERT_STATION_OFFLINE_WARN_RATIO=0.20
ALERT_STATION_OFFLINE_CRIT_RATIO=0.50
# Scheduler monitoring
ALERT_EXPECT_SCHEDULER=true

# Station/lobby housekeeping
# STATION_OFFLINE_AFTER_SECONDS=120
# STATION_OFFLINE_SWEEP_SECONDS=30
# LOBBY_ORPHAN_SECONDS=120
# LOBBY_CLEANUP_INTERVAL_SECONDS=30

# Kiosk settings
# KIOSK_CODE_TTL_HOURS=24
# KIOSK_IDLE_TIMEOUT_SECONDS=90000

# Mod processing
# MOD_SCAN_WORKERS=4

# WebSocket Commands (Agent communication)
# WS_COMMAND_TIMEOUT=30
# WS_MAX_RETRIES=3
# WS_RETRY_DELAY_SECONDS=2
# WS_COMMAND_QUEUE_TTL=300
# WS_PUBSUB=redis

# Session Time Warnings
# SESSION_TIME_WARNINGS_ENABLED=true
# SESSION_WARNING_CHECK_INTERVAL=30
# SESSION_WARNING_MINUTES=5,1

# Orphan Session Detection
# ORPHAN_SESSION_DETECTION_ENABLED=true
# ORPHAN_SESSION_CHECK_INTERVAL=60
# ORPHAN_SESSION_MINUTES=5

# Lobby Robustness
# LOBBY_HOST_PROMOTE_ENABLED=true
# LOBBY_HOST_PROMOTE_SECONDS=30
