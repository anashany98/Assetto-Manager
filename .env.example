# =============================================================================
# AC-MANAGER - Variables de Entorno para Producción Local (Docker)
# =============================================================================
# Copia este archivo a .env y cambia los valores marcados como "CAMBIAR"
# Genera valores seguros con: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ===================
# POSTGRESQL (DOCKER)
# ===================
POSTGRES_DB=ac_manager
POSTGRES_USER=ac_manager
# CAMBIAR: Genera una contraseña fuerte de 32+ caracteres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===================
# SEGURIDAD - KEYS Y TOKENS (OBLIGATORIO CAMBIAR)
# ===================
# Genera cada uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
SETUP_TOKEN=CHANGE_ME
AGENT_TOKEN=CHANGE_ME
UPDATE_SIGNING_KEY=CHANGE_ME

# Tokens públicos (solo lectura)
PUBLIC_API_TOKEN=CHANGE_ME
PUBLIC_WS_TOKEN=CHANGE_ME

# Tokens de clientes (opcional, formato: token:scope1,scope2)
CLIENT_TOKENS=

# ===================
# CONFIGURACIÓN
# ===================
ENVIRONMENT=production
AUTO_SCHEMA=false
REQUIRE_SECRETS=true
# CAMBIAR: Añade el dominio/IP real de producción
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ===================
# OPCIONALES
# ===================
PAYMENTS_ENABLED=false
EMAILS_ENABLED=false
REDIS_URL=redis://redis:6379/0
WS_PUBSUB=redis

# Observabilidad
ALERT_MIN_REQUESTS=50
ALERT_ERROR_RATE_WARN=0.10
ALERT_ERROR_RATE_CRIT=0.20
ALERT_P95_WARN_MS=800
ALERT_P95_CRIT_MS=2000
ALERT_STATIONS_MIN_TOTAL=1
ALERT_STATION_OFFLINE_WARN_RATIO=0.20
ALERT_STATION_OFFLINE_CRIT_RATIO=0.50
ALERT_EXPECT_SCHEDULER=false

# Kiosk
KIOSK_CODE_TTL_HOURS=24
KIOSK_IDLE_TIMEOUT_SECONDS=90000

# WebSocket
WS_COMMAND_TIMEOUT=30
WS_MAX_RETRIES=3

# Mods
MOD_SCAN_WORKERS=4
