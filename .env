# POSTGRESQL (DOCKER)
# ===================
POSTGRES_DB=ac_manager
POSTGRES_USER=ac_manager
POSTGRES_PASSWORD=ac_manager_2024_prod

# ===================
# SEGURIDAD - KEYS Y TOKENS (OBLIGATORIO CAMBIAR)
# =============================================================================
# Genera valores seguros con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
SECRET_KEY=a1442a50a20ba1938434b7a771b696f09966181530581e27cfec9767fd73d3a9
SETUP_TOKEN=99e56d17e1193008465713a3653fc503
AGENT_TOKEN=ebfad4239c283861f9df7a9fc0ae70d7
UPDATE_SIGNING_KEY=b3f507e6cde2e2b01a8ffce0166452583d155bdd85a95fd28cd45d986a3ab453

# Tokens públicos (solo lectura)
PUBLIC_API_TOKEN=d0d43ef029e9652a55f171ece10ea29a
PUBLIC_WS_TOKEN=2766e7d9e5b6245e6c19b9352b297e4b

# Tokens de clientes (opcional)
CLIENT_TOKENS=

# ===================
# CONFIGURACIÓN
# =============================================================================
ENVIRONMENT=production
AUTO_SCHEMA=false
REQUIRE_SECRETS=true
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Puertos
# FRONTEND_PORT=80
# BACKEND_PORT=8000

# ===================
# OPCIONALES
# =============================================================================
PAYMENTS_ENABLED=false
EMAILS_ENABLED=false
REDIS_URL=redis://redis:6379/0
WS_PUBSUB=

# Observabilidad
ALERT_MIN_REQUESTS=50
ALERT_ERROR_RATE_WARN=0.10
ALERT_ERROR_RATE_CRIT=0.20
ALERT_P95_WARN_MS=800
ALERT_P95_CRIT_MS=2000
ALERT_STATIONS_MIN_TOTAL=1
ALERT_STATION_OFFLINE_WARN_RATIO=0.20
ALERT_STATION_OFFLINE_CRIT_RATIO=0.50
ALERT_EXPECT_SCHEDULER=false

# Kiosk
KIOSK_CODE_TTL_HOURS=24
KIOSK_IDLE_TIMEOUT_SECONDS=90000

# WebSocket
WS_COMMAND_TIMEOUT=30
WS_MAX_RETRIES=3

# Mods
MOD_SCAN_WORKERS=4